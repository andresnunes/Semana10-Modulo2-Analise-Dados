# Copie este arquivo para ".env" e ajuste conforme necessário.

# ------------------------------------------------------------------
# Variáveis lidas pelo docker-compose.yml (container do PostgreSQL)
# ------------------------------------------------------------------
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vendas_dw
# Porta publicada no host. A 5434 foi escolhida para não conflitar com um
# PostgreSQL nativo (5432) nem com os containers das semanas anteriores
# (5432/5433). Se trocar aqui, troque também o DB_PORT abaixo.
PGPORT=5434

# ------------------------------------------------------------------
# Variáveis lidas pelo ETL em Python (etl/config.py)
# Devem apontar para o MESMO banco/porta definidos acima.
# DB_HOST=localhost porque o Postgres do docker-compose expõe a porta
# no host (a aplicação Python roda fora do container).
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5434
DB_NAME=vendas_dw
DB_USER=postgres
DB_PASSWORD=postgres

# ------------------------------------------------------------------
# Formato dos CSVs gerados (origem, transformado e estrela)
# Padrão brasileiro: separador ";" e vírgula como separador decimal -
# é o que o Power BI/Excel em pt-BR leem sem precisar de ajuste.
# Para Power BI em inglês use CSV_SEPARADOR=, e CSV_DECIMAL=.
# ------------------------------------------------------------------
CSV_SEPARADOR=;
CSV_DECIMAL=,
